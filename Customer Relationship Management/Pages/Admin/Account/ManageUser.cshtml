@page
@model Customer_Relationship_Management.Pages.Admin.Account.ManageUserModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý Tài khoản";
}

<style>
    /* ... Style cũ ... */
    .admin-gradient-heading {
        background: linear-gradient(90deg, #2f3542 0%, #58606c 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: bold;
        font-size: 2rem;
    }

    .btn-admin-gradient {
        background: linear-gradient(180deg, #2f3542 0%, #58606c 100%);
        color: #fff !important;
        border: none;
        transition: .3s;
    }

    .glass-card-admin {
        backdrop-filter: blur(8px);
        background: rgba(47,53,66,0.07);
        border-radius: 14px;
        padding: 0;
        border: 1px solid #eee;
    }

    .badge-admin {
        background: #2f3542;
        color: #fff;
        font-size: .7rem;
        padding: .35rem .5rem;
        border-radius: 6px;
    }

    .text-director {
        color: #d63384;
        font-weight: bold;
    }
</style>

<div class="container-fluid px-3 py-4 animate__animated animate__fadeIn">
    <div class="card glass-card-admin mb-4 border-0 shadow-sm">
        <div class="card-body">
            <h5 class="mb-3">Tạo người dùng mới</h5>
            <form method="post" asp-page-handler="Create" id="createUserForm" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Username</label>
                    <input class="form-control" asp-for="CreateInput.Username" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-control" asp-for="CreateInput.Email" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Họ tên</label>
                    <input class="form-control" asp-for="CreateInput.FullName" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Số điện thoại</label>
                    <input class="form-control" asp-for="CreateInput.Phone" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Vai trò</label>
                    <select class="form-select" asp-for="CreateInput.RoleID" id="roleSelect" required>
                        <option value="">-- Chọn vai trò --</option>
                        <option value="1">Employee (Cần Manager)</option>
                        <option value="2">Manager</option>
                        <option value="4">Director (Giám đốc)</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Quản lý trực tiếp</label>
                    <select class="form-select" asp-for="CreateInput.ManagerID" id="managerSelect" disabled>
                        <option value="">-- Chọn Manager --</option>
                        @foreach (var m in Model.Managers)
                        {
                            <option value="@m.Id">@m.Display</option>
                        }
                    </select>
                    <div class="small text-danger mt-1 d-none" id="mgrError">
                        <i class="bi bi-exclamation-circle"></i> Nhân viên bắt buộc phải chọn Manager.
                    </div>
                </div>

                <div class="col-12">
                    <button class="btn btn-admin-gradient">Tạo mới (Password: demo)</button>
                </div>
            </form>
        </div>
    </div>

    <div class="table-responsive table-card-admin card p-3">
        <table class="table admin-table-striped align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã</th>
                    <th>Username</th>
                    <th>Họ tên</th>
                    <th>Role</th>
                    <th>Manager</th>
                    <th>Trạng thái</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Users)
                {
                    bool isAdmin = u.RoleID == 3 || u.RoleName == "Admin";
                    bool isDirector = u.RoleID == 4 || u.RoleName == "Director";
                    <tr>
                        <td>@u.UserCode</td>
                        <td>@u.Username</td>
                        <td>@u.FullName</td>
                        <td>
                            @if (isAdmin)
                            {
                                <span class="badge-admin">Admin</span>
                            }
                            else if (isDirector)
                            {
                                <span class="badge bg-danger">Director</span>
                            }
                            else
                            {
                                <span>@u.RoleName</span>
                            }
                        </td>
                        <td>
                            @if (!isAdmin && !isDirector && u.RoleName == "Employee" && !u.IsDeleted)
                            {
                                <form method="post" asp-page-handler="UpdateManager" class="d-flex gap-2 align-items-center js-confirm"
                                      data-title="Đổi Manager?" data-text="Cập nhật quản lý cho @u.Username?">
                                    <input type="hidden" name="UpdateMgr.UserID" value="@u.UserID" />
                                    <select class="form-select form-select-sm" name="UpdateMgr.ManagerID" style="min-width: 150px;">
                                        <option value="">-- Chọn --</option>
                                        @foreach (var m in Model.Managers)
                                        {
                                            <option value="@m.Id" selected="@(u.ManagerID == m.Id)">@m.Display</option>
                                        }
                                    </select>
                                    <button class="btn btn-sm btn-admin-gradient"><i class="bi bi-check"></i></button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td>
                            @if (u.IsDeleted)
                            {
                                <span class="badge bg-secondary">Đã xóa</span>
                            }
                            else
                            {
                                <span class="@(u.Status == "Locked" ? "text-danger fw-bold" : "text-success")">
                                    @u.Status
                                </span>
                            }
                        </td>
                        <td class="text-end">
                            @if (isAdmin)
                            {
                                <span class="text-muted fst-italic small"><i class="bi bi-shield-lock-fill"></i> Protected</span>
                            }
                            else if (u.IsDeleted)
                            {
                                <span class="small text-muted">Deleted</span>
                            }
                            else
                            {
                                <div class="btn-group" role="group">
                                    @* 1. Nút Yêu cầu đổi mật khẩu (Force Change) *@
                                    <form method="post" asp-page-handler="ForceChange" asp-route-id="@u.UserID" class="d-inline js-confirm"
                                          data-title="Yêu cầu đổi mật khẩu?"
                                          data-text="Người dùng @u.Username sẽ buộc phải đổi mật khẩu ở lần đăng nhập tới.">
                                        <button class="btn btn-sm btn-outline-warning" title="Yêu cầu đổi mật khẩu">
                                            <i class="bi bi-key"></i>
                                        </button>
                                    </form>

                                    @* 2. Nút Khóa / Mở khóa *@
                                    <form method="post" asp-page-handler="ToggleDelete" asp-route-id="@u.UserID" class="d-inline js-confirm"
                                          data-title="@(u.Status == "Locked" ? "Mở khóa?" : "Khóa?")"
                                          data-text="@(u.Status == "Locked" ? $"Mở khóa {u.Username}?" : $"Khóa {u.Username}?")"
                                          data-confirm="@(u.Status == "Locked" ? "#2f3542" : "#dc3545")">
                                        <button class="btn btn-sm @(u.Status == "Locked" ? "btn-admin-gradient" : "btn-outline-danger")" title="@(u.Status == "Locked" ? "Mở khóa" : "Khóa tài khoản")">
                                            <i class="bi @(u.Status == "Locked" ? "bi-unlock" : "bi-lock")"></i>
                                        </button>
                                    </form>

                                    @* 3. Nút Xóa mềm *@
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@u.UserID" class="d-inline js-confirm"
                                          data-title="Xóa tài khoản?" data-text="Hành động này sẽ xóa mềm tài khoản @u.Username" data-confirm="#dc3545">
                                        <button class="btn btn-sm btn-danger" title="Xóa tài khoản"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // 1. Xử lý Logic ẩn/hiện Manager Select
        const roleSelect = document.getElementById('roleSelect');
        const managerSelect = document.getElementById('managerSelect');
        const mgrError = document.getElementById('mgrError');

        function toggleManagerSelect() {
            const role = roleSelect.value;
            // Chỉ Role = 1 (Employee) mới active ô chọn Manager
            if (role === '1') {
                managerSelect.removeAttribute('disabled');
                managerSelect.setAttribute('required', 'required');
            } else {
                managerSelect.setAttribute('disabled', 'disabled');
                managerSelect.removeAttribute('required');
                managerSelect.value = "";
                mgrError.classList.add('d-none');
            }
        }

        roleSelect?.addEventListener('change', toggleManagerSelect);

        // 2. Validate form submit
        document.getElementById('createUserForm')?.addEventListener('submit', function (e) {
            const role = roleSelect.value;
            const mgr = managerSelect.value;
            if (role === '1' && !mgr) {
                e.preventDefault();
                mgrError.classList.remove('d-none');
            }
        });

        // 3. Confirm Dialog
        document.addEventListener('submit', function (e) {
            const form = e.target.closest('.js-confirm');
            if (!form) return;
            e.preventDefault();
            Swal.fire({
                title: form.dataset.title || 'Xác nhận?',
                text: form.dataset.text || '',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: form.dataset.confirm || '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) form.submit();
            });
        });

        // Init logic khi load trang
        toggleManagerSelect();
    </script>
}