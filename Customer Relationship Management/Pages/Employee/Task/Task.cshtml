@page
@model Customer_Relationship_Management.Pages.Employee.Task.TaskModel
@{
    Layout = "/Pages/Shared/_LayoutEmployee.cshtml";
    ViewData["Title"] = "Công việc được giao cho tôi";
    ViewData["ActiveMenu"] = "Task";
}

<div class="container-fluid py-4 px-3">
    @if (TempData["SuccessMessage"] is string sm)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">@sm<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["ErrorMessage"] is string em)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">@em<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <div class="mb-4">
        <h2 class="fw-bold text-gradient mb-0">Danh sách Công việc của bạn</h2>
        <p class="text-muted mb-0 small">Theo dõi công việc, xem chi tiết và hoàn thành</p>
    </div>

    <!-- Bộ lọc -->
    <form method="get" class="card glass-card border-0 shadow-sm mb-3">
        <div class="card-body row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-semibold">Từ khóa</label>
                <input type="text" name="Keyword" value="@Model.Keyword" class="form-control shadow-sm" placeholder="Tiêu đề hoặc mô tả..." />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Trạng thái</label>
                <select name="Status" class="form-select">
                    <option value="">-- Tất cả --</option>
                    @foreach (var st in new[] { "Pending", "In-Progress", "Done" })
                    {
                        <option value="@st" selected="@(string.Equals(Model.Status, st, StringComparison.OrdinalIgnoreCase))">@st</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Từ hạn</label>
                <input type="date" name="FromDue" value="@Model.FromDue?.ToString("yyyy-MM-dd")" class="form-control shadow-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Đến hạn</label>
                <input type="date" name="ToDue" value="@Model.ToDue?.ToString("yyyy-MM-dd")" class="form-control shadow-sm" />
            </div>
            <div class="col-md-1 d-flex">
                <button type="submit" class="btn btn-gradient px-4 ms-auto align-self-end">Lọc</button>
            </div>
        </div>
    </form>

    <!-- Danh sách công việc - chỉ một bảng, đẹp -->
    <div class="card border-0 shadow-lg glass-card">
        <div class="card-header bg-gradient-blue text-white d-flex align-items-center justify-content-between">
            <h5 class="mb-0 fw-semibold">Danh sách công việc</h5>
            <span class="small opacity-75">Nhấn "Xem" để xem chi tiết và hoàn thành</span>
        </div>
        <div class="table-responsive">
            <table class="table align-middle table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Tiêu đề</th>
                        <th>Hạn</th>
                        <th>Nhắc tại</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Tasks.Any())
                    {
                        foreach (var t in Model.Tasks)
                        {
                            var badgeClass = t.Status?.ToLower() == "done"
                            ? "success"
                            : (t.Status?.ToLower() == "in-progress" ? "warning text-dark" : "secondary");
                            var isOverdue = t.DueDate != null && t.DueDate < DateTime.UtcNow && t.Status != "Done";
                            <tr class="@(isOverdue ? "table-danger" : "")">
                                <td class="fw-semibold">@t.Title</td>
                                <td>
                                    @if (t.DueDate.HasValue)
                                    {
                                        @t.DueDate.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        @if (isOverdue)
                                        {
                                            <span class="badge bg-danger ms-1">QUÁ HẠN</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@(t.ReminderAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                                <td><span class="badge bg-@badgeClass">@t.Status</span></td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2 w-100">
                                        <button class="btn btn-sm btn-outline-primary btn-view"
                                                data-detail-url="@Url.Page("./Task", null, new { handler = "TaskDetail", id = t.TaskID }, null)">
                                            Xem
                                        </button>
                                        @if (t.Status == "Pending")
                                        {
                                            <form method="post" asp-page-handler="Confirm" asp-route-id="@t.TaskID" class="d-inline">
                                                <button class="btn btn-sm btn-outline-warning" type="submit">Xác nhận</button>
                                            </form>
                                        }
                                        @if (t.Status == "In-Progress")
                                        {
                                            <button class="btn btn-sm btn-outline-success btn-complete"
                                                    data-id="@t.TaskID" data-title="@t.Title">
                                                Hoàn thành
                                            </button>
                                        }
                                        @if (t.Status == "Done")
                                        {
                                            <span class="badge bg-success py-2 px-3">✓ Hoàn thành</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" class="text-muted text-center">Bạn chưa có công việc nào.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal chi tiết -->
<div class="modal fade" id="taskDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg glass-card">
            <div class="modal-header bg-gradient-blue text-white">
                <h5 class="modal-title fw-bold">Chi tiết công việc</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="taskDetailContent" class="p-2 text-start">Đang tải... </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal xác nhận Hoàn thành -->
<div class="modal fade" id="completeConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg glass-card">
            <div class="modal-header bg-gradient-blue text-white">
                <h5 class="modal-title">Xác nhận hoàn thành</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Bạn có chắc chắn muốn hoàn thành công việc: <strong id="completeTaskTitle"></strong>?</p>
            </div>
            <div class="modal-footer">
                <form id="completeForm" method="post" asp-page-handler="Complete" class="d-none">
                    <input type="hidden" name="id" id="completeTaskId" />
                </form>
                <button class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-success" id="confirmCompleteBtn">Hoàn thành</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .btn-gradient {
            background: linear-gradient(45deg, #007bff, #00d4ff);
            color: #fff;
            border: none;
            transition: 0.3s;
        }

            .btn-gradient:hover {
                transform: scale(1.05);
                opacity: 0.9;
            }

        .text-gradient {
            background: linear-gradient(90deg, #007bff, #00c6ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .glass-card {
            backdrop-filter: blur(10px);
            background: rgba(255,255,255,0.96);
            border-radius: 14px;
            color: #212529;
        }

        .bg-gradient-blue {
            background: linear-gradient(45deg, #007bff, #00b4ff);
        }

        .table-danger {
            background-color: rgba(220,53,69,0.08);
        }

        .badge {
            font-size: 0.97em;
        }

        .btn-outline-warning {
            border-color: #ffc107 !important;
            color: #314530 !important;
        }

        .btn-outline-success {
            border-color: #198754 !important;
            color: #198754 !important;
        }
    </style>
}

@section Scripts {
    <script>
        const $ = (s, r = document) => r.querySelector(s);

        document.addEventListener('click', async (e) => {
            const viewBtn = e.target.closest('.btn-view');
            const completeBtn = e.target.closest('.btn-complete');

            if (viewBtn) {
                const url = viewBtn.getAttribute('data-detail-url');
                $('#taskDetailContent').innerHTML = 'Đang tải...';
                new bootstrap.Modal(document.getElementById('taskDetailModal')).show();
                try {
                    const res = await fetch(url, { credentials: 'include' });
                    const data = await res.json();
                    if (!data) { $('#taskDetailContent').innerHTML = '<div class="text-danger">Không tải được dữ liệu.</div>'; return; }
                    const now = new Date();
                    const isOverdue = data.dueDate && new Date(data.dueDate) < now && data.status !== 'Done';
                    $('#taskDetailContent').innerHTML = `
                        <div class="row g-3 text-start">
                            <div class="col-md-6">
                                <p><strong>Tiêu đề:</strong> ${esc(data.title || '')}</p>
                                <p><strong>Trạng thái:</strong> <span class="badge bg-${data.status?.toLowerCase() === 'done' ? 'success' : data.status?.toLowerCase() === 'in-progress' ? 'warning' : 'secondary'}">${data.status || 'Pending'}</span></p>
                                ${isOverdue ? '<p><span class="badge bg-danger">QUÁ HẠN</span></p>' : ''}
                            </div>
                            <div class="col-md-6">
                                <p><strong>Ngày giờ thực hiện:</strong> ${data.dueDate ? new Date(data.dueDate).toLocaleString('vi-VN') : '—'}</p>
                                <p><strong>Nhắc tại:</strong> ${data.reminderAt ? new Date(data.reminderAt).toLocaleString('vi-VN') : '—'}</p>
                            </div>
                            <div class="col-12">
                                <p><strong>Mô tả:</strong><br/>${esc(data.description || 'Không có')}</p>
                            </div>
                        </div>`;
                } catch {
                    $('#taskDetailContent').innerHTML = '<div class="text-danger">Lỗi khi tải dữ liệu.</div>';
                }
                return;
            }

            if (completeBtn) {
                const id = completeBtn.getAttribute('data-id');
                const title = completeBtn.getAttribute('data-title');
                $('#completeTaskId').value = id;
                $('#completeTaskTitle').textContent = title || '';
                new bootstrap.Modal(document.getElementById('completeConfirmModal')).show();
                return;
            }
        });

        document.getElementById('confirmCompleteBtn')?.addEventListener('click', () => {
            document.getElementById('completeForm').submit();
        });

        function esc(str) {
            return (str || '').replace(/[&<>"']/g, m => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
            }[m]));
        }
    </script>
}