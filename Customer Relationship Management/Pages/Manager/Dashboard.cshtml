@page
@model Customer_Relationship_Management.Pages.Manager.DashboardModel
@{
    Layout = "_LayoutManager";
    ViewData["Title"] = "Dashboard";
    ViewData["ActiveMenu"] = "Dashboard";
}

<div class="container-fluid py-4 px-3 animate__animated animate__fadeIn">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-gradient-mgr mb-0">Dashboard Tổng quan</h2>
            <p class="text-muted mb-0 small">Chào mừng trở lại! Dưới đây là tình hình kinh doanh của Team.</p>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted small mb-1 fw-semibold text-uppercase">Khách hàng</p>
                        <h3 class="fw-bold text-dark mb-0">@Model.TotalCustomers</h3>
                    </div>
                    <div class="icon-box bg-primary bg-opacity-10 text-primary rounded-circle p-3">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted small mb-1 fw-semibold text-uppercase">Hợp đồng chờ duyệt</p>
                        <h3 class="fw-bold text-warning mb-0">@Model.PendingContracts</h3>
                    </div>
                    <div class="icon-box bg-warning bg-opacity-10 text-warning rounded-circle p-3">
                        <i class="bi bi-file-earmark-text-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted small mb-1 fw-semibold text-uppercase">Deal đang mở</p>
                        <h3 class="fw-bold text-success mb-0">@Model.OpenDealsCount</h3>
                    </div>
                    <div class="icon-box bg-success bg-opacity-10 text-success rounded-circle p-3">
                        <i class="bi bi-briefcase-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-body p-3 d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted small mb-1 fw-semibold text-uppercase">Task Due Today</p>
                        <h3 class="fw-bold text-danger mb-0">@Model.TasksDueToday</h3>
                    </div>
                    <div class="icon-box bg-danger bg-opacity-10 text-danger rounded-circle p-3">
                        <i class="bi bi-calendar-check-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4 g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                <div class="table-title-band table-title-band-mgr p-3">
                    <div class="fw-semibold"><i class="bi bi-bar-chart-fill me-2"></i>Tổng quan Pipeline Deal (Giá trị)</div>
                </div>
                <div class="card-body">
                    @if (Model.PipelineSummary != null && Model.PipelineSummary.Any())
                    {
                        <div class="mx-auto" style="max-width: 900px;">
                            <canvas id="pipelineChart" height="140"></canvas>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted fst-italic mb-0">Không có dữ liệu pipeline deal trong team.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                <div class="table-title-band table-title-band-mgr p-3">
                    <div class="fw-semibold"><i class="bi bi-clock-history me-2"></i>Hoạt động gần đây</div>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @if (Model.RecentActivities != null && Model.RecentActivities.Any())
                        {
                            foreach (var act in Model.RecentActivities)
                            {
                                <li class="list-group-item border-bottom-0 py-3 d-flex align-items-start gap-3">
                                    <div class="fs-4 @act.ColorClass">
                                        <i class="bi @act.Icon"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="text-dark fw-medium small">@act.Message</div>
                                        <div class="text-muted" style="font-size: 0.75rem;">@act.Time</div>
                                    </div>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="list-group-item text-muted text-center py-4 small">Chưa có hoạt động nào trong team.</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .text-gradient-mgr {
            background: linear-gradient(180deg, #198754 0%, #20c997 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .table-title-band-mgr {
            background: linear-gradient(180deg, #198754 0%, #20c997 100%);
            color: #fff;
            box-shadow: 0 3px 12px rgba(25, 135, 84, 0.25);
        }

        .icon-box {
            width: 50px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }

        .list-group-item:last-child {
            border-bottom: none !important;
        }

        /* Thêm style để đồng nhất với các trang khác */
        .table-title-band {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-weight: 700;
            line-height: 1.2;
            box-shadow: 0 3px 12px rgba(0,0,0,.08);
            border-radius: 0;
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Lấy dữ liệu từ C# model cho Biểu đồ Pipeline
        const pipelineData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PipelineSummary));

        if (Object.keys(pipelineData).length > 0) {
            const labels = Object.keys(pipelineData);
            const values = Object.values(pipelineData);

            // Hàm tạo màu dựa trên Giai đoạn
            const getStageColor = (label) => {
                switch (label) {
                    case 'Closed Won': return 'rgba(32, 201, 151, 0.8)'; // Xanh ngọc
                    case 'Closed Lost': return 'rgba(220, 53, 69, 0.8)'; // Đỏ
                    case 'Contract Sent': return 'rgba(0, 123, 255, 0.8)'; // Xanh dương
                    case 'Negotiation': return 'rgba(255, 193, 7, 0.8)'; // Vàng
                    case 'Lead': return 'rgba(25, 135, 84, 0.8)'; // Xanh lá đậm
                    default: return 'rgba(108, 117, 125, 0.8)'; // Xám
                }
            };

            const backgroundColors = labels.map(label => getStageColor(label));
            const borderColors = labels.map(label => getStageColor(label).replace('0.8', '1'));

            const ctx = document.getElementById('pipelineChart').getContext('2d');

            new Chart(ctx, {
                type: 'bar', // Biểu đồ cột
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Tổng Giá trị (VNĐ)',
                        data: values,
                        backgroundColor: backgroundColors,
                        borderColor: borderColors,
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'rgba(25, 135, 84, 0.9)',
                            titleColor: '#fff',
                            bodyColor: '#fff',
                            padding: 10,
                            callbacks: {
                                label: function(context) {
                                    let label = context.dataset.label || '';
                                    if (context.parsed.y !== null) {
                                        label += new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(context.parsed.y);
                                    }
                                    return label;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { borderDash: [2, 4], color: '#f0f0f0' },
                            ticks: {
                                font: { size: 11 },
                                callback: function(value) {
                                    // Hiển thị đơn vị Triệu VNĐ
                                    return (value / 1000000).toLocaleString('vi-VN') + ' Tr';
                                }
                            }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { size: 12, weight: 'bold' } }
                        }
                    }
                }
            });
        }
    </script>
}