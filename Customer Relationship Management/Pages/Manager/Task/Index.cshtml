@page
@model Customer_Relationship_Management.Pages.Manager.Task.IndexModel
@{
    ViewData["Title"] = "Quản lý Công việc Team";
    ViewData["ActiveMenu"] = "ManagerTasks";
    Layout = "_LayoutManager";
}

<!-- Xuất teamMembers cho JS sửa task -->
<script>
    window.teamMembers = [
        @foreach (var emp in Model.TeamMembers)
        {
                <text>{ userID: @emp.UserID, fullName: "@emp.FullName" },</text>
        }
    ];
</script>

<div class="container-fluid py-4 px-3 animate__animated animate__fadeIn">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-gradient-mgr mb-0">Quản lý Công Việc Nhân viên</h2>
            <p class="text-muted mb-0 small">Giao công việc, chỉnh sửa, xóa, theo dõi tiến độ nhân viên</p>
        </div>
    </div>

    @foreach (var key in new[] { "SuccessMessage", "ErrorMessage", "InfoMessage" })
    {
        if (TempData[key] is string msg)
        {
            var cls = key == "SuccessMessage" ? "success" : key == "ErrorMessage" ? "danger" : "info";
            <div class="alert alert-@cls alert-dismissible fade show small">
                @msg
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    }

    <!-- Card Giao công việc mới -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; overflow: hidden;">
        <div class="card-header" style="background: linear-gradient(180deg, #198754 0%, #20c997 100%); border: none; color: white; padding: 1rem;">
            <h5 class="mb-0">Giao công việc cho nhân viên</h5>
            <small style="opacity: 0.9;">Chọn nhân viên và giao công việc</small>
        </div>
        <div class="card-body" style="background: white;">
            <form id="assignForm" method="post" asp-page-handler="Assign" class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Tiêu đề công việc *</label>
                    <input name="AssignTask.Title" maxlength="200" class="form-control" placeholder="Nhập tiêu đề..." required />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Chọn nhân viên *</label>
                    <div class="card" style="background: white; max-height: 180px; overflow-y: auto; border-radius: 6px; border: 2px solid #198754;">
                        <div class="card-body p-3">
                            @if (Model.TeamMembers.Any())
                            {
                                @foreach (var emp in Model.TeamMembers)
                                {
                                    <div class="form-check mb-2">
                                        <input class="form-check-input employee-checkbox" type="checkbox" name="AssignTask.EmployeeIds" value="@emp.UserID" id="emp_@emp.UserID" />
                                        <label class="form-check-label fw-semibold" for="emp_@emp.UserID" style="cursor: pointer; color: #333;">
                                            @emp.FullName
                                        </label>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted mb-0">Không có nhân viên nào</p>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Mô tả</label>
                    <textarea name="AssignTask.Description" rows="2" class="form-control" placeholder="Ghi chú chi tiết... "></textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Ngày hạn</label>
                    <input name="AssignTask.DueDate" type="datetime-local" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Nhắc lúc</label>
                    <input name="AssignTask.ReminderAt" type="datetime-local" class="form-control" />
                </div>
                <div class="col-12 text-end">
                    <button type="submit" class="btn btn-gradient-mgr btn-filter-mgr">Giao Công việc</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Bộ lọc -->
    <form method="get" class="card border-0 shadow-sm mb-4" style="background: white; border-radius: 12px;">
        <div class="card-body row g-2 align-items-end small">
            <div class="col-md-3">
                <label class="form-label fw-semibold">Từ khóa</label>
                <input type="text" name="Keyword" value="@Model.Keyword" class="form-control form-control-sm" placeholder="Tiêu đề / mô tả..." />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Trạng thái</label>
                <select name="Status" class="form-select form-select-sm">
                    <option value="">-- Tất cả --</option>
                    <option value="Pending" selected="@(Model.Status == "Pending")">Pending</option>
                    <option value="In-Progress" selected="@(Model.Status == "In-Progress")">In-Progress</option>
                    <option value="Done" selected="@(Model.Status == "Done")">Done</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Nhân viên</label>
                <select name="AssignedTo" class="form-select form-select-sm">
                    <option value="">-- Tất cả --</option>
                    @foreach (var emp in Model.TeamMembers)
                    {
                        <option value="@emp.UserID" selected="@(Model.AssignedTo == emp.UserID)">@emp.FullName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Hạn từ</label>
                <input type="date" name="FromDue" value="@Model.FromDue?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Hạn đến</label>
                <input type="date" name="ToDue" value="@Model.ToDue?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-12 filter-actions mt-2">
                <div class="d-flex justify-content-end gap-2">
                    <button class="btn btn-gradient-mgr btn-filter-mgr" type="submit">Lọc</button>
                    <a asp-page="./Index" class="btn btn-gradient-mgr btn-filter-mgr">Đặt lại</a>
                </div>
            </div>
        </div>
    </form>

    <!-- Bảng danh sách công việc -->
    <div class="card border-0 shadow-sm" style="background: white; border-radius: 12px; overflow: hidden;">
        <div class="p-3" style="background: linear-gradient(180deg, #198754 0%, #20c997 100%); color: white;">
            <div class="fw-semibold">Danh sách công việc</div>
            <small class="opacity-75">Quản lý, chỉnh sửa, xóa công việc nhân viên</small>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small" style="background: white;">
                <thead class="table-light">
                    <tr style="background: #f8f9fa;">
                        <th>ID</th>
                        <th>Tiêu đề</th>
                        <th>Nhân viên</th>
                        <th>Hạn</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Tasks.Any())
                    {
                        foreach (var t in Model.Tasks)
                        {
                            var badge = t.Status?.ToLower() switch
                            {
                                "done" => "success",
                                "in-progress" => "warning text-dark",
                                _ => "secondary"
                            };
                            var isOverdue = t.DueDate != null && t.DueDate < DateTime.UtcNow && t.Status != "Done";
                            var isDone = t.Status?.ToLower() == "done";

                            <tr style="background: white;" class="@(isOverdue ? "table-danger" : "")">
                                <td>@t.TaskID</td>
                                <td class="fw-semibold">@t.Title</td>
                                <td>@t.AssignedToUser?.FullName</td>
                                <td>
                                    @if (t.DueDate.HasValue)
                                    {
                                        @t.DueDate.Value.ToLocalTime().ToString("dd/MM HH:mm")
                                        @if (isOverdue)
                                        {
                                            <span class="badge bg-danger ms-1">QUÁ HẠN</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td><span class="badge bg-@badge">@t.Status</span></td>
                                <td class="text-center">
                                    @if (!isDone)
                                    {
                                        <div class="d-inline-flex gap-1">
                                            <button type="button" class="btn btn-outline-info btn-sm btn-view-detail" data-id="@t.TaskID">
                                                Xem
                                            </button>
                                            <button type="button" class="btn btn-outline-warning btn-sm btn-edit-task" data-id="@t.TaskID">
                                                Sửa
                                            </button>
                                            <button type="button" class="btn btn-outline-danger btn-sm btn-delete-task" data-id="@t.TaskID" data-title="@t.Title">
                                                Xóa
                                            </button>
                                            <form method="post" class="d-inline" asp-page-handler="Remind" asp-route-id="@t.TaskID">
                                                <button type="submit" class="btn btn-outline-secondary btn-sm ms-1">Nhắc lại</button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success py-2 px-3">✓ Hoàn thành</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr style="background: white;"><td colspan="6" class="text-muted text-center py-3">Không có công việc. </td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal chi tiết / Xem -->
<div class="modal fade" id="taskDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="background: white; color: #000;">
            <div class="modal-header" style="background: linear-gradient(180deg, #198754 0%, #20c997 100%); border: none; color: white;">
                <h5 class="modal-title fw-bold" id="taskDetailTitle">Chi tiết Công việc</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="taskDetailContent" style="background: white; color: #000;">
                <div class="text-muted">Đang tải... </div>
            </div>
            <div class="modal-footer" style="background: white; border-top: 1px solid #e9ecef;">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                <button class="btn btn-warning btn-sm" id="btnSwitchToEdit">Chỉnh sửa</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal chỉnh sửa -->
<div class="modal fade" id="taskEditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="background: white; color: #000;">
            <div class="modal-header" style="background: linear-gradient(180deg, #198754 0%, #20c997 100%); border: none; color: white;">
                <h5 class="modal-title fw-bold">Chỉnh sửa Công việc</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="taskEditContent" style="background: white; color: #000;">
                <div class="text-muted">Đang tải...</div>
            </div>
            <div class="modal-footer" style="background: white; border-top: 1px solid #e9ecef;">
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-gradient-mgr btn-filter-mgr" id="btnSaveEdit">Lưu</button>
            </div>
        </div>
    </div>
</div>

<!-- Form ẩn dành cho Edit -->
<form id="editTaskForm" method="post" asp-page-handler="Edit" class="d-none">
    <input type="hidden" name="EditTask.TaskID" />
    <input type="hidden" name="EditTask.AssignedToUserID" />
    <input type="hidden" name="EditTask.Title" />
    <input type="hidden" name="EditTask.Description" />
    <input type="hidden" name="EditTask.DueDate" />
    <input type="hidden" name="EditTask.ReminderAt" />
</form>

<!-- Modal xác nhận Xóa -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="background: white; color: #000;">
            <div class="modal-header" style="background: linear-gradient(180deg, #198754 0%, #20c997 100%); border: none; color: white;">
                <h5 class="modal-title">Xác nhận xóa</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="background: white; color: #000;">
                <p>Bạn chắc chắn muốn xóa công việc: <strong id="deleteTaskTitle"></strong>?</p>
            </div>
            <div class="modal-footer" style="background: white; border-top: 1px solid #e9ecef;">
                <form id="deleteForm" method="post" asp-page-handler="Delete" class="d-none">
                    <input type="hidden" name="id" id="deleteTaskId" />
                </form>
                <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                <button class="btn btn-danger btn-sm" id="confirmDeleteBtn">Xóa</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .btn-gradient-mgr {
            background: linear-gradient(180deg, #198754 0%, #20c997 100%);
            color: #fff;
            border: none;
            transition: 0.3s;
        }

            .btn-gradient-mgr:hover {
                transform: translateY(-1px);
                opacity: 0.95;
            }

        .btn-filter-mgr {
            padding: 0.55rem 1.05rem;
            font-weight: 500;
            font-size: 0.85rem;
            min-width: 84px;
            border-radius: 0.45rem;
        }

        .text-gradient-mgr {
            background: linear-gradient(180deg, #198754 0%, #20c997 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .table-danger {
            background-color: rgba(220,53,69,0.1);
        }

        .form-check-input {
            width: 1.25em;
            height: 1.25em;
            margin-top: 0.125em;
            cursor: pointer;
            accent-color: #198754;
        }

            .form-check-input:checked {
                background-color: #198754;
                border-color: #198754;
            }

        .form-check-label {
            user-select: none;
        }

        .modal-label-green {
            color: #198754;
            font-weight: 600;
        }

        .modal-body input, .modal-body textarea {
            color: #000 !important;
            background: white !important;
            border: 1px solid #ddd;
        }
    </style>
}

@section Scripts {
    <script>
        const getEl = (selector) => document.querySelector(selector);
        let currentTaskData = null;
        const detailModalEl = getEl('#taskDetailModal');
        const editModalEl = getEl('#taskEditModal');
        const deleteModalEl = getEl('#deleteConfirmModal');
        const detailModal = new bootstrap.Modal(detailModalEl);
        const editModal = new bootstrap.Modal(editModalEl);
        const deleteModal = new bootstrap.Modal(deleteModalEl);

        getEl('#assignForm')?.addEventListener('submit', function(e) {
            const checkboxes = document.querySelectorAll('.employee-checkbox:checked');
            const title = this.querySelector('[name="AssignTask.Title"]').value;
            if (!title || title.trim() === '') { e.preventDefault(); alert('Vui lòng nhập tiêu đề công việc!'); return false; }
            if (checkboxes.length === 0) { e.preventDefault(); alert('Vui lòng chọn ít nhất một nhân viên!'); return false; }
            return true;
        });

        document.addEventListener('click', function(e) {
            if (e.target.classList.contains('btn-view-detail')) {
                e.preventDefault();
                const taskId = e.target.getAttribute('data-id');
                loadTaskDetail(taskId);
            }
        });

        async function loadTaskDetail(taskId) {
            getEl('#taskDetailContent').innerHTML = '<div class="text-muted text-center"><span class="spinner-border spinner-border-sm me-2"></span>Đang tải...</div>';
            detailModal.show();
            try {
                const url = `?handler=TaskDetail&id=${taskId}`;
                const response = await fetch(url);
                const data = await response.json();
                if (!data) { getEl('#taskDetailContent').innerHTML = '<div class="alert alert-danger">Không tìm thấy công việc.</div>'; return; }
                currentTaskData = data;
                renderTaskDetail(data);
            } catch (error) {
                getEl('#taskDetailContent').innerHTML = '<div class="alert alert-danger">Lỗi khi tải dữ liệu.</div>';
            }
        }

        function renderTaskDetail(data) {
            const htmlContent =`
                <div class="small" style="color: #000;">
                    <p><strong style="color: #198754;">ID:</strong> ${data.taskID}</p>
                    <p><strong style="color: #198754;">Tiêu đề:</strong> ${escapeHtml(data.title || '')}</p>
                    <p><strong style="color: #198754;">Nhân viên:</strong> ${escapeHtml(data.assignedName || 'Chưa gán')}</p>
                    <p><strong style="color: #198754;">Trạng thái:</strong> ${data.status || 'Pending'}</p>
                    <p><strong style="color: #198754;">Hạn:</strong> ${data.dueDate ? new Date(data.dueDate).toLocaleString('vi-VN') : '—'}</p>
                    <p><strong style="color: #198754;">Nhắc:</strong> ${data.reminderAt ? new Date(data.reminderAt).toLocaleString('vi-VN') : '—'}</p>
                    <p><strong style="color: #198754;">Mô tả:</strong><br/> ${escapeHtml(data.description || 'Không có')}</p>
                </div>
            `;
            getEl('#taskDetailContent').innerHTML = htmlContent;
        }

        document.addEventListener('click', function(e) {
            if (e.target.classList.contains('btn-edit-task')) {
                e.preventDefault();
                const taskId = e.target.getAttribute('data-id');
                loadTaskForEdit(taskId);
            }
        });

        getEl('#btnSwitchToEdit')?.addEventListener('click', function() {
            if (currentTaskData) {
                detailModal.hide();
                renderEditForm(currentTaskData);
                editModal.show();
            }
        });

        async function loadTaskForEdit(taskId) {
            try {
                const url = `?handler=TaskDetail&id=${taskId}`;
                const response = await fetch(url);
                const data = await response.json();
                if (!data) { alert('Không tìm thấy công việc.'); return; }
                currentTaskData = data;
                renderEditForm(data);
                editModal.show();
            } catch (error) {
                alert('Lỗi khi tải dữ liệu.');
            }
        }

        function renderEditForm(data) {
            const htmlForm = `
                <form id="editFormContent" class="row g-3" style="color: #000;">
                    <div class="col-12">
                        <label class="form-label fw-semibold modal-label-green">Tiêu đề</label>
                        <input type="text" name="title" class="form-control" maxlength="200" value="${escapeHtml(data.title || '')}" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold modal-label-green">Mô tả</label>
                        <textarea name="description" class="form-control" rows="4">${escapeHtml(data.description || '')}</textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold modal-label-green">Nhân viên</label>
                        <select name="assignedToUserId" class="form-select">
                            ${teamListHtml(data.assignedToUserID)}
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold modal-label-green">Ngày hạn</label>
                        <input type="datetime-local" name="dueDate" class="form-control" value="${dtLocal(data.dueDate)}" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold modal-label-green">Nhắc lúc</label>
                        <input type="datetime-local" name="reminderAt" class="form-control" value="${dtLocal(data.reminderAt)}" />
                    </div>
                </form>
            `;
            getEl('#taskEditContent').innerHTML = htmlForm;
        }
        function teamListHtml(currentId) {
            var arr = window.teamMembers || [];
            return arr.map(e => `<option value="${e.userID}"${String(e.userID)==String(currentId) ?' selected':''}>${e.fullName}</option>`).join('');
        }
        function dtLocal(dtStr) {
            if (!dtStr) return "";
            const d = new Date(dtStr);
            return d.toISOString().substring(0,16);
        }
        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        getEl('#btnSaveEdit')?.addEventListener('click', function () {
            const form = getEl('#editFormContent');
            if (!form) return;

            const title = form.querySelector('[name="title"]').value;
            const description = form.querySelector('[name="description"]').value;
            const assignedToUserId = form.querySelector('[name="assignedToUserId"]').value;
            const dueDate = form.querySelector('[name="dueDate"]').value;
            const reminderAt = form.querySelector('[name="reminderAt"]').value;

            const editForm = getEl('#editTaskForm');
            editForm.querySelector('[name="EditTask.TaskID"]').value = currentTaskData.taskID;
            editForm.querySelector('[name="EditTask.AssignedToUserID"]').value = assignedToUserId;
            editForm.querySelector('[name="EditTask.Title"]').value = title;
            editForm.querySelector('[name="EditTask.Description"]').value = description;
            editForm.querySelector('[name="EditTask.DueDate"]').value = dueDate;
            editForm.querySelector('[name="EditTask.ReminderAt"]').value = reminderAt;
            editForm.submit();
        });

        document.addEventListener('click', function(e) {
            if (e.target.classList.contains('btn-delete-task')) {
                e.preventDefault();
                const taskId = e.target.getAttribute('data-id');
                const taskTitle = e.target.getAttribute('data-title');
                getEl('#deleteTaskId').value = taskId;
                getEl('#deleteTaskTitle').textContent = taskTitle || '';
                deleteModal.show();
            }
        });

        getEl('#confirmDeleteBtn')?.addEventListener('click', function() {
            getEl('#deleteForm').submit();
        });
    </script>
}